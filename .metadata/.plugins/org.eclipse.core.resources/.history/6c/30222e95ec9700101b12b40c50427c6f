#ifndef API_INC_API_DELAY_TF_H_
#define API_INC_API_DELAY_TF_H_

#include <stdbool.h>
#include <stdint.h>

typedef uint32_t tick_t;
typedef enum{disable_mode, able_mode, ready_mode}mode_t;
typedef struct{
   tick_t startTime;
   tick_t duration;
   mode_t running;
} delay_t;


void delayInit( delay_t * delay, tick_t duration );
mode_t delayRead( delay_t * delay );
void delayDisable(delay_t * delay);

#endif /* API_INC_API_DELAY_TF_H_ */
