/* USER CODE BEGIN 4 */

void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef* hadc){
  if (hadc->Instance == ADC1){
	  HAL_ADC_Stop_IT(&hadc1);
	  adc_value_x = HAL_ADC_GetValue(hadc);
	  ADC_data.dato_ready=true;
  }
}

void PWM_Control(uint32_t control){
	__HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_1, control);
}

event_t events(){
	event_t event_r=null_event;

	if(ADC_data.dato_ready==true){
		event_r=ADC_ready;
	}

	if(delayRead(&delay_mech) == ready_mode){
		event_r=time_off;
	}

	if(!HAL_GPIO_ReadPin(THE_BUTTON)){			//niego porque tiene resistencia de pull-up (NC)
		event_r=button;
	}
	return event_r;
}
/*Funcion para la maquina de estados*/
void FSM(state_t *state,event_t evt){
	switch(*state){
		case wait:
			if(evt==button){
				SM_init(&delay_mech);
				*state=write;
			}
			break;
		case read:
			if(evt==time_off){
				action_write(adc_value_x, &delay_mech);
				*state=write;
			}
			if(evt==button){
				action_wait();
				*state=wait;
			}
			break;
		case write:
			if(evt==ADC_ready){
				action_read();
				*state=read;
			}
			if(evt==button){
				action_wait();
				*state=wait;
			}
			break;
		default:
			break;
	}
}

/*Accion que se realiza cuando se transiciona al estado 'read'*/
void action_read(void){
	ADC_data.dato_ready=false;
	HAL_ADC_Start_IT(&hadc1);
}

void SM_init(delay_t * mechanic_delay){
	PWM_Control(0);
	delayInit(mechanic_delay, mechanic_tao);
	HAL_ADC_Start_IT(&hadc1);
}

/*Accion que se realiza cuando se transiciona al estado 'wait'*/
void action_wait(void){
	wellcome();
}

/*Accion que se realiza cuando se transiciona al estado 'write'*/
void action_write(uint32_t ADC_value,delay_t * mechanic_delay){
	//mensaje(ADC_value);
	delayDisable(&delay_mech);
	PWM_Control(ADC_value);
	delayInit(mechanic_delay, mechanic_tao);
}

