#ifndef API_INC_API_DELAY_H_
#define API_INC_API_DELAY_H_

#include <stdbool.h>
#include <stdint.h>

typedef uint32_t tick_t;
typedef enum{disable, able, ready}delay_s;
typedef struct{
   tick_t startTime;
   tick_t duration;
   bool_t running;
} delay_t;


void delayInit( delay_t * delay, tick_t duration );
delay_s delayRead( delay_t * delay );

#endif /* API_INC_API_DELAY_H_ */
